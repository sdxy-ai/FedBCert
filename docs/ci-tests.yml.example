name: Tests
on: [push, pull_request]
permissions:
  contents: read
jobs:
  cpu:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.10'
          cache: pip
      - name: Install pinned CPU dependencies
        run: |
          python -m pip install --upgrade pip
          python -m pip install torch==2.8.0 --index-url https://download.pytorch.org/whl/cpu
          python -m pip install -r requirements-no-torch.txt
          python -m pip install -e . --no-deps
          python -m pip check
      - name: Check included results
        run: |
          python scripts/smoke_certificate.py
          python scripts/verify_review_artifact.py
          python scripts/verify_reference_results.py
          python scripts/verify_gap_reference_results.py
          python scripts/verify_on_demand_reference.py
      - name: Run portable tests
        env:
          OMP_NUM_THREADS: '1'
          MKL_NUM_THREADS: '1'
        run: python -m pytest -q -m 'not optional'
